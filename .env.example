# ============================================================================
# VARIÁVEIS DE AMBIENTE (.env) - MSN PRIVADO P2P (VITINHO & WILL)
# ============================================================================

# URL da sua API publicada na Vercel (para chamadas serverless de Sinalização/Rankings)
VITE_VERCEL_API_URL=https://msn-privado-p2p.vercel.app

# Credenciais do Supabase (Realtime Presence + Handshake WebRTC + Banco PostgreSQL)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-do-supabase
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-para-vercel-api

# PINs de 4 dígitos de autenticação rápida (Tela 1)
VITE_PIN_VITINHO=1234
VITE_PIN_WILL=4321

# Servidores TURN (Fallback quando NAT Simétrico impedir P2P direto - Cloudflare TURN / Metered.ca)
VITE_TURN_URL=turn:standard.relay.metered.ca:80
VITE_TURN_USERNAME=seu_usuario_turn
VITE_TURN_CREDENTIAL=sua_senha_turn
